(*              ---> Resource Access <---

    M1  :  U       ==>  KC      : [N1, (resourceAccessReq)]_https
    M2  :  KC      ==>  ASEV    : [N1, (attestCheckReq)]_https
    M3  :  ASEV    ==>  KC      : [N1, (attestCheckRes)]_https
    M4  :  KC      ==>  ZTPE    : [N1, (policyEvalReq)]_https
    M5  :  ZTPE    ==>  ASEV    : [N1, (verifyMfaReq)]_https
    M6  :  Bend    ==>  U       : [N1, (mfaReq)]_https
    M7  :  U       ==>  Bend    : [N1, (mfaRes)]_https
    M8  :  Bend    ==>  ZTPE    : [N1, (verifyMfaRes)]_https
    M9  :  ZTPE    ==>  DCtrl   : [N1, (policyEvalRes)]_https
    M10 :  DCtrl   ==>  U       : [N1, (resourceAccessRes)]_https

          (ASEV notifies Bend after M5)
*)


free c: channel.

type host.
type nonce.
type pkey.
type skey.


(* Public key encryption *)
fun pk(skey): pkey.
fun encrypt(bitstring, pkey): bitstring.
reduc forall x: bitstring, y: skey; decrypt(encrypt(x,pk(y)),y) = x.

(* Signatures *)
fun sign(bitstring, skey): bitstring.
reduc forall m: bitstring, k: skey; checksign(sign(m,k), pk(k)) = m.

(* Hash function *)
fun hash(bitstring): bitstring.


(* Secrecy assumptions *)
not attacker(new skU).
not attacker(new skBend).
not attacker(new skASEV).
not attacker(new skKC).
not attacker(new skZTPE).
not attacker(new skDCtrl).


(* Honest host names *)
free U, Bend, ASEV, KC, ZTPE, DCtrl: host.

(* Secret declaration *)
free resourceAccessReq, attestCheckReq, attestCheckRes, policyEvalReq, policyEvalRes,
     verifyMfaReq, mfaReq, mfaRes, verifyMfaRes, resourceAccessRes : bitstring[private].

(* Secrecy queries *)
query attacker(attestCheckRes);
      attacker(mfaRes);
      attacker(verifyMfaRes);
      attacker(policyEvalRes);
      attacker(resourceAccessRes).

(* --- Events by message step --- *)
(* M1  (U → KC)         : event beginResourceAccess invokes when U sends resourceAccessReq. *)
(* M2  (KC → ASEV)      : event beginAttestCheck invokes when KC sends attestCheckReq. *)
(* M3  (ASEV → KC)      : event endAttestCheck marks when KC obtains attestCheckRes. *)
(* M4  (KC → ZTPE)      : event beginPolicyEval invokes when KC sends policyEvalReq. *)
(* M5  (ZTPE → ASEV)    : event beginVerifyMfa invokes when ZTPE sends verifyMfaReq. *)
(* M6  (Bend → U)       : event beginMfa invokes when Bend sends mfaReq. *)
(* M7  (U → Bend)       : event endMfa marks when Bend obtains mfaRes. *)
(* M8  (Bend → ZTPE)    : event endVerifyMfa marks when ZTPE obtains verifyMfaRes. *)
(* M9  (ZTPE → DCtrl)   : event endPolicyEval marks when DCtrl obtains policyEvalRes. *)
(* M10 (DCtrl → U)      : event endResourceAccess marks when U obtains resourceAccessRes. *)

event beginResourceAccess(bitstring).
event endResourceAccess(bitstring).
event beginAttestCheck(bitstring).
event endAttestCheck(bitstring).
event beginPolicyEval(bitstring).
event endPolicyEval(bitstring).
event beginVerifyMfa(bitstring).
event endVerifyMfa(bitstring).
event beginMfa(bitstring).
event endMfa(bitstring).


(* Correspondence queries *)
query resourceAccessReq: bitstring, resourceAccessRes: bitstring;
      event(endResourceAccess(resourceAccessRes)) ==> event(beginResourceAccess(resourceAccessReq)).

query attestCheckReq: bitstring, attestCheckRes: bitstring;
      event(endAttestCheck(attestCheckRes)) ==> event(beginAttestCheck(attestCheckReq)).

query policyEvalReq: bitstring, policyEvalRes: bitstring;
      event(endPolicyEval(policyEvalRes)) ==> event(beginPolicyEval(policyEvalReq)).

query verifyMfaReq: bitstring, verifyMfaRes: bitstring;
      inj-event(endVerifyMfa(verifyMfaRes)) ==> inj-event(beginVerifyMfa(verifyMfaReq)).

query mfaReq: bitstring, mfaRes: bitstring;
      inj-event(endMfa(mfaRes)) ==> inj-event(beginMfa(mfaReq)).

query resourceAccessRes: bitstring, attestCheckRes: bitstring;
      inj-event(endResourceAccess(resourceAccessRes)) ==> inj-event(endAttestCheck(attestCheckRes)).

query resourceAccessRes: bitstring, policyEvalRes: bitstring;
      event(endResourceAccess(resourceAccessRes)) ==> event(endPolicyEval(policyEvalRes)).

(* Authorization: access is granted only after policy evaluation. *)
(* MFA bypass: access is granted only after a completed WebAuthn/MFA proof. *)
query resourceAccessRes: bitstring, mfaRes: bitstring;
      event(endResourceAccess(resourceAccessRes)) ==> event(endMfa(mfaRes)).

query resourceAccessRes: bitstring, verifyMfaRes: bitstring;
      event(endResourceAccess(resourceAccessRes)) ==> event(endVerifyMfa(verifyMfaRes)).


let processU(skU: skey, pkKC: pkey, pkBend: pkey, pkDCtrl: pkey) =
    in(c, (xKC: host, xBend: host, xDCtrl: host));
    if (xKC = KC) then
    if (xBend = Bend) then
    if (xDCtrl = DCtrl) then
    let pkU = pk(skU) in
    new N1: nonce;
    event beginResourceAccess(resourceAccessReq);

    (* M1 *)
    out(c, encrypt((N1, sign(resourceAccessReq, skU), hash(resourceAccessReq)), pkKC));

    (* M6 *)
    in(c, encM6: bitstring);
    let (xN1: nonce, signedMfaReq: bitstring, hashedMfaReq: bitstring) = decrypt(encM6, skU) in
    let (M6: bitstring) = checksign(signedMfaReq, pkBend) in
    if (hashedMfaReq = hash(M6)) then
    if (xN1 = N1) then
    if (M6 = mfaReq) then
    (* M7 *)
    out(c, encrypt((N1, sign(mfaRes, skU), hash(mfaRes)), pkBend));

    (* M10 *)
    in(c, encM10: bitstring);
    let (yN1: nonce, signedResourceAccessRes: bitstring, hashedResourceAccessRes: bitstring) = decrypt(encM10, skU) in
    let (M10: bitstring) = checksign(signedResourceAccessRes, pkDCtrl) in
    if (hashedResourceAccessRes = hash(M10)) then
    if (yN1 = N1) then
    if (M10 = resourceAccessRes) then
    event endResourceAccess(M10).


let processKC(skKC: skey, pkU: pkey, pkASEV: pkey, pkZTPE: pkey) =
    in(c, (xU: host, xASEV: host, xZTPE: host));
    if (xU = U) then
    if (xASEV = ASEV) then
    if (xZTPE = ZTPE) then
    let pkKC = pk(skKC) in

    (* M1 *)
    in(c, encM1: bitstring);
    let (N1: nonce, signedResourceAccessReq: bitstring, hashedResourceAccessReq: bitstring) = decrypt(encM1, skKC) in
    let (M1: bitstring) = checksign(signedResourceAccessReq, pkU) in
    if (hashedResourceAccessReq = hash(M1)) then
    event beginAttestCheck(attestCheckReq);
    (* M2 *)
    out(c, encrypt((N1, sign(attestCheckReq, skKC), hash(attestCheckReq)), pkASEV));

    (* M3 *)
    in(c, encM3: bitstring);
    let (xN1: nonce, signedAttestCheckRes: bitstring, hashedAttestCheckRes: bitstring) = decrypt(encM3, skKC) in
    let (M3pair: bitstring) = checksign(signedAttestCheckRes, pkASEV) in
    if (hashedAttestCheckRes = hash(M3pair)) then
    if (xN1 = N1) then
    if (M3pair = (attestCheckReq, attestCheckRes)) then
    event endAttestCheck(attestCheckRes);
    event beginPolicyEval(policyEvalReq);
    (* M4 *)
    out(c, encrypt((N1, sign(policyEvalReq, skKC), hash(policyEvalReq)), pkZTPE)).


let processASEV(skASEV: skey, pkKC: pkey, pkZTPE: pkey, pkBend: pkey) =
    in(c, (xKC: host, xZTPE: host, xBend: host));
    if (xKC = KC) then
    if (xZTPE = ZTPE) then
    if (xBend = Bend) then
    let pkASEV = pk(skASEV) in

    (* M2 *)
    in(c, encM2: bitstring);
    let (N1: nonce, signedAttestCheckReq: bitstring, hashedAttestCheckReq: bitstring) = decrypt(encM2, skASEV) in
    let (M2: bitstring) = checksign(signedAttestCheckReq, pkKC) in
    if (hashedAttestCheckReq = hash(M2)) then
    if (M2 = attestCheckReq) then
    (* M3 *)
    out(c, encrypt((N1, sign((M2, attestCheckRes), skASEV), hash((M2, attestCheckRes))), pkKC));

    (* M5 *)
    in(c, encM5: bitstring);
    let (xN1: nonce, signedVerifyMfaReq: bitstring, hashedVerifyMfaReq: bitstring) = decrypt(encM5, skASEV) in
    let (M5: bitstring) = checksign(signedVerifyMfaReq, pkZTPE) in
    if (hashedVerifyMfaReq = hash(M5)) then
    if (xN1 = N1) then
    if (M5 = verifyMfaReq) then
    (* notify Bend after M5 *)
    out(c, encrypt((N1, sign(M5, skASEV), hash(M5)), pkBend)).


let processBend(skBend: skey, pkU: pkey, pkASEV: pkey, pkZTPE: pkey) =
    in(c, (xU: host, xASEV: host, xZTPE: host));
    if (xU = U) then
    if (xASEV = ASEV) then
    if (xZTPE = ZTPE) then
    let pkBend = pk(skBend) in

    (* ASEV notification after M5 *)
    in(c, encNotify: bitstring);
    let (N1: nonce, signedNotify: bitstring, hashedNotify: bitstring) = decrypt(encNotify, skBend) in
    let (Mnotify: bitstring) = checksign(signedNotify, pkASEV) in
    if (hashedNotify = hash(Mnotify)) then
    if (Mnotify = verifyMfaReq) then
    event beginMfa(mfaReq);
    (* M6 *)
    out(c, encrypt((N1, sign(mfaReq, skBend), hash(mfaReq)), pkU));

    (* M7 *)
    in(c, encM7: bitstring);
    let (xN1: nonce, signedMfaRes: bitstring, hashedMfaRes: bitstring) = decrypt(encM7, skBend) in
    let (M7: bitstring) = checksign(signedMfaRes, pkU) in
    if (hashedMfaRes = hash(M7)) then
    if (xN1 = N1) then
    if (M7 = mfaRes) then
    event endMfa(M7);
    (* M8 *)
    out(c, encrypt((N1, sign((verifyMfaReq, verifyMfaRes), skBend), hash((verifyMfaReq, verifyMfaRes))), pkZTPE)).


let processZTPE(skZTPE: skey, pkKC: pkey, pkASEV: pkey, pkBend: pkey, pkDCtrl: pkey) =
    in(c, (xKC: host, xASEV: host, xBend: host, xDCtrl: host));
    if (xKC = KC) then
    if (xASEV = ASEV) then
    if (xBend = Bend) then
    if (xDCtrl = DCtrl) then
    let pkZTPE = pk(skZTPE) in

    (* M4 *)
    in(c, encM4: bitstring);
    let (N1: nonce, signedPolicyEvalReq: bitstring, hashedPolicyEvalReq: bitstring) = decrypt(encM4, skZTPE) in
    let (M4: bitstring) = checksign(signedPolicyEvalReq, pkKC) in
    if (hashedPolicyEvalReq = hash(M4)) then
    if (M4 = policyEvalReq) then
    event beginVerifyMfa(verifyMfaReq);
    (* M5 *)
    out(c, encrypt((N1, sign(verifyMfaReq, skZTPE), hash(verifyMfaReq)), pkASEV));

    (* M8 *)
    in(c, encM8: bitstring);
    let (xN1: nonce, signedVerifyMfaRes: bitstring, hashedVerifyMfaRes: bitstring) = decrypt(encM8, skZTPE) in
    let (M8pair: bitstring) = checksign(signedVerifyMfaRes, pkBend) in
    if (hashedVerifyMfaRes = hash(M8pair)) then
    if (xN1 = N1) then
    if (M8pair = (verifyMfaReq, verifyMfaRes)) then
    event endVerifyMfa(verifyMfaRes);
    event endPolicyEval(policyEvalRes);
    (* M9 *)
    out(c, encrypt((N1, sign((M4, policyEvalRes), skZTPE), hash((M4, policyEvalRes))), pkDCtrl)).


let processDCtrl(skDCtrl: skey, pkU: pkey, pkZTPE: pkey) =
    in(c, xZTPE: host);
    if (xZTPE = ZTPE) then
    let pkDCtrl = pk(skDCtrl) in

    (* M9 *)
    in(c, encM9: bitstring);
    let (N1: nonce, signedPolicyEvalRes: bitstring, hashedPolicyEvalRes: bitstring) = decrypt(encM9, skDCtrl) in
    let (M9pair: bitstring) = checksign(signedPolicyEvalRes, pkZTPE) in
    if (hashedPolicyEvalRes = hash(M9pair)) then
    if (M9pair = (policyEvalReq, policyEvalRes)) then
    (* M10 *)
    out(c, encrypt((N1, sign(resourceAccessRes, skDCtrl), hash(resourceAccessRes)), pkU)).


process
    new skU: skey;
    new skBend: skey;
    new skASEV: skey;
    new skKC: skey;
    new skZTPE: skey;
    new skDCtrl: skey;
    let pkU = pk(skU) in out(c, pkU);
    let pkBend = pk(skBend) in out(c, pkBend);
    let pkASEV = pk(skASEV) in out(c, pkASEV);
    let pkKC = pk(skKC) in out(c, pkKC);
    let pkZTPE = pk(skZTPE) in out(c, pkZTPE);
    let pkDCtrl = pk(skDCtrl) in out(c, pkDCtrl);

    ( (!processU(skU, pkKC, pkBend, pkDCtrl))
    | (!processKC(skKC, pkU, pkASEV, pkZTPE))
    | (!processASEV(skASEV, pkKC, pkZTPE, pkBend))
    | (!processBend(skBend, pkU, pkASEV, pkZTPE))
    | (!processZTPE(skZTPE, pkKC, pkASEV, pkBend, pkDCtrl))
    | (!processDCtrl(skDCtrl, pkU, pkZTPE)) )
